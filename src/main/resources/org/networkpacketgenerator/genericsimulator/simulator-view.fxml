<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox alignment="CENTER_LEFT" spacing="15.0" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.networkpacketgenerator.genericsimulator.SimulatorController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <VBox spacing="5.0">
            <Label text="Hedef IP:" style="-fx-font-weight: bold;"/>
            <TextField fx:id="ipTextField" text="127.0.0.1" prefWidth="120.0"/>
        </VBox>

        <VBox spacing="5.0">
            <Label text="Hedef Port:" style="-fx-font-weight: bold;"/>
            <TextField fx:id="portTextField" text="5005" prefWidth="80.0"/>
        </VBox>
    </HBox>

    <HBox spacing="20" alignment="CENTER_LEFT">

        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Protocol:" style="-fx-font-weight: bold;" />
            <ComboBox fx:id="protocolComboBox" prefWidth="150.0" />
        </VBox>

        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Endian:" style="-fx-font-weight: bold;" />
            <ComboBox fx:id="endianComboBox" prefWidth="150.0" />
        </VBox>

    </HBox>

    <HBox spacing="10.0" alignment="BOTTOM_LEFT">


        <Button text="+"
                onAction="#onAddRowButtonClick"
                style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;"/>
    </HBox>

    <VBox fx:id="dynamicRowsVBox" spacing="10.0"/>

    <HBox spacing="10.0" alignment="CENTER">
        <Button text="Gonder"
                onAction="#onSendButtonClick"
                prefWidth="150.0"
                style="-fx-font-size: 14px; -fx-cursor: hand;"/>

        <Button text="XML Dosyasini Goster"
                onAction="#onShowXmlButtonClick"
                prefWidth="180.0"
                style="-fx-font-size: 14px; -fx-cursor: hand;"/>
    </HBox>
</VBox>